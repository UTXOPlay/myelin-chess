{
  "name": "myelin-chess-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/build-web.mjs",
    "start": "node host/start.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:host": "node --test host/*.test.mjs",
    "build:native": "cargo build --release --locked --manifest-path games/chess/Cargo.toml --target-dir target"
  },
  "dependencies": {
    "express": "5.1.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "chess.js": "1.4.0"
  }
}
